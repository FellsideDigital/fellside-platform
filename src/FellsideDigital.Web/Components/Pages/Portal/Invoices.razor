@page "/Portal/Invoices"
@attribute [Authorize]
@layout PortalLayout

@using FellsideDigital.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using FellsideDigital.Web.Data
@using FellsideDigital.Web.Services
@using FellsideDigital.Web.Components.Layout
@using FellsideDigital.Web.Components.Shared

<PageTitle>Invoices — Fellside Digital Portal</PageTitle>

<!-- Page header -->
<div class="mb-8">
    <p class="text-xs font-semibold text-accent uppercase tracking-widest mb-1">Billing</p>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Invoices</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-neutral-400">All invoices raised against your projects.</p>
</div>

@if (_invoices is null)
{
    <!-- Skeleton loader -->
    <div class="animate-pulse space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="rounded-2xl border border-gray-200 dark:border-white/5 bg-white dark:bg-neutral-900 p-5 h-24"></div>
            }
        </div>
        <div class="rounded-2xl border border-gray-200 dark:border-white/5 bg-white dark:bg-neutral-900 h-64"></div>
    </div>
}
else if (!_invoices.Any() && _schedules.Count == 0)
{
    <EmptyState Padding="p-14"
                IconContainerClass="size-12 rounded-2xl mb-4"
                Title="No invoices yet"
                Subtitle="Invoices will appear here once your project manager raises them.">
        <Icon>
            <svg class="size-6 text-gray-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
        </Icon>
    </EmptyState>
}
else
{
    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

        <StatCard Label="Monthly billing"
                  ValueSize="text-2xl"
                  IconBg="bg-sky-50 dark:bg-sky-400/10"
                  Value="@($"£{_monthlyTotal:N2}")"
                  Subtext="@($"Across {_schedules.Count} active retainer{(_schedules.Count == 1 ? "" : "s")}")">
            <Icon>
                <svg class="size-4 text-sky-500 dark:text-sky-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            </Icon>
        </StatCard>

        <StatCard Label="Outstanding"
                  ValueSize="text-2xl"
                  IconBg="bg-amber-50 dark:bg-amber-400/10"
                  Value="@($"£{_invoices.Where(i => i.Status is InvoiceStatus.Sent or InvoiceStatus.Overdue).Sum(i => i.Amount):N2}")"
                  Subtext="Awaiting payment">
            <Icon>
                <svg class="size-4 text-amber-500 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            </Icon>
        </StatCard>

        <StatCard Label="Paid"
                  ValueSize="text-2xl"
                  IconBg="bg-emerald-50 dark:bg-emerald-400/10"
                  Value="@($"£{_paidTotal:N2}")"
                  Subtext="Total paid to date">
            <Icon>
                <svg class="size-4 text-emerald-500 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
            </Icon>
        </StatCard>

        <StatCard Label="Total"
                  ValueSize="text-2xl"
                  IconBg="bg-accent-hover"
                  Value="@($"£{_invoices.Sum(i => i.Amount):N2}")"
                  Subtext="Total invoiced">
            <Icon>
                <svg class="size-4 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
                </svg>
            </Icon>
        </StatCard>

    </div>

    @if (_schedules.Count > 0)
    {
        <!-- Recurring invoices -->
        <div class="rounded-2xl border border-gray-200/80 dark:border-white/5 bg-white dark:bg-neutral-900 shadow-sm overflow-hidden mb-6">
            <div class="px-6 pt-5 pb-3">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Recurring invoices</h2>
                <p class="text-xs text-gray-500 dark:text-neutral-400 mt-0.5">
                    Billed monthly — each is collected on its payment day, shown below.
                </p>
            </div>
            <div class="overflow-x-auto">
            <table class="@TableStyles.Table">
                <thead>
                    <tr class="@TableStyles.HeadRow">
                        <Th>Name</Th>
                        <Th Class="hidden sm:table-cell">Project</Th>
                        <Th>Amount</Th>
                        <Th Class="hidden sm:table-cell">Payment day</Th>
                        <Th Class="hidden md:table-cell">Paid to date</Th>
                        <Th Right>Next payment</Th>
                    </tr>
                </thead>
                <tbody class="@TableStyles.Body">
                    @foreach (var s in _schedules)
                    {
                        <tr class="@TableStyles.Row">
                            <Td>
                                <p class="text-sm font-medium text-gray-900 dark:text-white">@s.Title</p>
                            </Td>
                            <Td Class="hidden sm:table-cell">
                                <span class="text-sm text-gray-700 dark:text-neutral-300">@s.Project?.Name</span>
                            </Td>
                            <Td>
                                <span class="text-sm font-semibold text-gray-900 dark:text-white">@s.Currency @s.Amount.ToString("N2")</span>
                                <span class="text-xs text-gray-500 dark:text-neutral-400">/month</span>
                            </Td>
                            <Td Class="hidden sm:table-cell">
                                <span class="text-sm text-gray-700 dark:text-neutral-300">@s.PaymentDayOfMonth.ToOrdinal()</span>
                            </Td>
                            <Td Class="hidden md:table-cell">
                                <span class="text-sm font-semibold text-gray-900 dark:text-white">@s.Currency @RecurringService.CollectedToDate(s, DateTime.UtcNow).ToString("N2")</span>
                                <span class="block text-[11px] text-gray-400 dark:text-neutral-500">since @s.FirstPaymentDate.ToString("MMM yyyy")</span>
                            </Td>
                            <Td Class="text-right">
                                <span class="text-sm text-gray-500 dark:text-neutral-400">@s.NextIssueDate.ToString("d MMM yyyy")</span>
                            </Td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }

    @if (_invoices.Any())
    {
    <!-- Invoice table -->
    <div class="rounded-2xl border border-gray-200/80 dark:border-white/5 bg-white dark:bg-neutral-900 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
        <table class="@TableStyles.Table">
            <thead>
                <tr class="@TableStyles.HeadRow">
                    <Th>Invoice</Th>
                    <Th Class="hidden sm:table-cell">Project</Th>
                    <Th Class="hidden md:table-cell">Due</Th>
                    <Th>Amount</Th>
                    <Th>Status</Th>
                    <Th Right>File</Th>
                </tr>
            </thead>
            <tbody class="@TableStyles.Body">
                @foreach (var inv in _invoices)
                {
                    <tr class="@TableStyles.Row">
                        <Td>
                            <p class="text-sm font-medium text-gray-900 dark:text-white">@inv.Title</p>
                            <p class="text-xs text-gray-500 dark:text-neutral-400 mt-0.5">@inv.IssuedAt.ToLocalTime().ToString("d MMM yyyy")</p>
                        </Td>
                        <Td Class="hidden sm:table-cell">
                            <span class="text-sm text-gray-700 dark:text-neutral-300">@inv.Project?.Name</span>
                        </Td>
                        <Td Class="hidden md:table-cell">
                            <span class="text-sm text-gray-500 dark:text-neutral-400">
                                @(inv.DueAt.HasValue ? inv.DueAt.Value.ToLocalTime().ToString("d MMM yyyy") : "—")
                            </span>
                        </Td>
                        <Td>
                            <span class="text-sm font-semibold text-gray-900 dark:text-white">@inv.Currency @inv.Amount.ToString("N2")</span>
                        </Td>
                        <Td>
                            <StatusBadge CssClasses="@BadgeHelpers.InvoiceStatusBadge(inv.Status)"
                                         Label="@inv.Status.ToString()" />
                        </Td>
                        <Td Class="text-right">
                            @if (_fileLinks.TryGetValue(inv.Id, out var links))
                            {
                                <div class="flex justify-end">
                                    <FileActions ViewUrl="@links.ViewUrl" DownloadUrl="@links.DownloadUrl" />
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-gray-400 dark:text-neutral-500">—</span>
                            }
                        </Td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
    }
}
