@page "/websites"
@using FellsideDigital.Web.Components.Pages
@using FellsideDigital.Web.Data
@using FellsideDigital.Web.Services
@inject IHeroProjectService HeroProjectService

<PageTitle>Website Design Cumbria &amp; Lake District | Fellside Digital</PageTitle>

<SeoHead Title="Website Design Cumbria &amp; Lake District | Fellside Digital"
         Description="Bespoke website design and development in Cumbria and the Lake District. No templates — pixel-perfect, high-performance sites built around your business. Fixed-price quotes."
         CanonicalUrl="https://fellsidedigital.co.uk/websites" />

<HeadContent>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Service",
      "name": "Website Design & Development",
      "description": "Bespoke website design and development for businesses in Cumbria, the Lake District, and across the UK. No templates — every site is hand-crafted, high-performance, and built for longevity.",
      "provider": { "@@id": "https://fellsidedigital.co.uk/#business" },
      "serviceType": "Web Development",
      "areaServed": [
        { "@@type": "Place", "name": "Cumbria" },
        { "@@type": "Place", "name": "Lake District" },
        { "@@type": "Place", "name": "United Kingdom" }
      ],
      "url": "https://fellsidedigital.co.uk/websites",
      "offers": {
        "@@type": "Offer",
        "description": "Fixed-price website design and development. Static marketing sites from £295.",
        "priceCurrency": "GBP",
        "priceSpecification": { "@@type": "UnitPriceSpecification", "price": "295", "priceCurrency": "GBP", "minPrice": "295" }
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [
        { "@@type": "ListItem", "position": 1, "name": "Home", "item": "https://fellsidedigital.co.uk/" },
        { "@@type": "ListItem", "position": 2, "name": "Website Design & Development", "item": "https://fellsidedigital.co.uk/websites" }
      ]
    }
    </script>
</HeadContent>

<div class="flex flex-col w-full max-w-full overflow-x-hidden
            bg-white dark:bg-neutral-950 text-slate-900 dark:text-white
            transition-colors duration-300">

    <!-- ── HERO ──────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden py-24 sm:py-32 px-6 bg-white dark:bg-neutral-950">
        <div class="grain-overlay" aria-hidden="true"></div>
        <div class="hero-aura" aria-hidden="true">
            <div class="hero-aura-blob"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row lg:items-center gap-12">
                <div class="max-w-2xl">
                    <a href="/"
                       class="inline-flex items-center gap-1.5 text-xs font-medium
                              text-slate-400 dark:text-neutral-500
                              hover:text-slate-600 dark:hover:text-neutral-300 mb-8 transition-colors">
                        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                        </svg>
                        Back to home
                    </a>
                    <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-3">
                        Website Design & Development
                    </p>
                    <h1 class="text-5xl sm:text-6xl font-semibold tracking-tight text-balance
                               text-slate-900 dark:text-white mb-6">
                        Beautiful websites that
                        <span class="text-accent"> actually perform</span>
                    </h1>
                    <p class="text-lg text-slate-500 dark:text-neutral-400 leading-relaxed mb-8">
                        Every website we build is crafted from scratch — no page builders, no templates.
                        Bespoke web development for businesses in Cumbria, the Lake District, and across the UK.
                        High-performance, pixel-perfect, built for longevity.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="/contact"
                           class="rounded-xl bg-accent px-6 py-3 text-sm font-semibold
                                  text-white shadow-sm hover:opacity-90 transition-all text-center">
                            Start your project
                        </a>
                        <a href="#pricing"
                           class="rounded-xl px-6 py-3 text-sm font-semibold text-center
                                  text-slate-700 dark:text-neutral-200
                                  ring-1 ring-slate-200 dark:ring-white/10
                                  hover:bg-slate-50 dark:hover:bg-white/5 transition-all">
                            See pricing
                        </a>
                    </div>
                </div>

                <!-- Browser mockup -->
                <div class="flex-1 hidden lg:block">
                    <div class="rounded-2xl overflow-hidden ring-1 ring-slate-200 dark:ring-white/10 bg-white dark:bg-neutral-900 shadow-2xl">
                        <div class="bg-slate-100 dark:bg-neutral-800 px-4 py-3 flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-400"></div>
                            <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                            <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                            <div class="flex-1 ml-3 h-5 rounded bg-white dark:bg-neutral-700 flex items-center px-3">
                                <span class="text-xs text-slate-400 dark:text-neutral-500">fellsidedigital.co.uk</span>
                            </div>
                        </div>
                        <div class="p-6 space-y-3">
                            <div class="h-6 w-2/3 rounded-lg bg-accent/60"></div>
                            <div class="h-3 w-full rounded bg-slate-200 dark:bg-neutral-700"></div>
                            <div class="h-3 w-5/6 rounded bg-slate-200 dark:bg-neutral-700"></div>
                            <div class="h-3 w-4/5 rounded bg-slate-100 dark:bg-neutral-800"></div>
                            <div class="mt-5 grid grid-cols-3 gap-3">
                                <div class="rounded-lg bg-accent h-20"></div>
                                <div class="rounded-lg bg-accent/40 h-20"></div>
                                <div class="rounded-lg bg-accent/20 h-20"></div>
                            </div>
                            <div class="mt-3 h-8 w-28 rounded-lg bg-accent"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── PORTFOLIO ──────────────────────────────────────────────────────── -->
    <section id="portfolio" class="py-20 px-6 bg-slate-50 dark:bg-neutral-900 transition-colors duration-300">
        <div class="max-w-7xl mx-auto">
            <SectionHeader Label="Our work"
                           Heading="What we've built."
                           Description="A selection of real projects we've delivered for clients across the UK." />

            @if (_projects.Count == 0)
            {
                <div class="mt-12 max-w-xl mx-auto">
                    <EmptyState Padding="p-12"
                                IconContainerClass="size-12 rounded-2xl mb-4"
                                Title="Portfolio coming soon"
                                Subtitle="We're preparing a selection of recent projects to showcase here. In the meantime, get in touch to see examples of our work.">
                        <Icon>
                            <svg class="size-6 text-gray-400 dark:text-neutral-500" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                            </svg>
                        </Icon>
                    </EmptyState>
                </div>
            }
            else
            {
                <div class="mt-4 flex flex-col divide-y divide-slate-200 dark:divide-white/5">
                    @foreach (var (project, index) in _projects.Select((p, i) => (p, i)))
                    {
                        <ProjectShowcaseRow Project="project" Index="index" />
                    }
                </div>
            }
        </div>
    </section>

    <!-- ── PRICING ────────────────────────────────────────────────────────── -->
    <section id="pricing" class="py-20 px-6 bg-white dark:bg-neutral-950 transition-colors duration-300">
        <div class="max-w-7xl mx-auto">
            <SectionHeader Label="Pricing"
                           Heading="Simple, fixed-price packages."
                           Description="Every project is quoted up front — no hourly surprises. The prices below are starting points; we'll confirm a fixed price once we've scoped your project together." />

            <!-- Setup tiers -->
            <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
                @foreach (var tier in _websiteTiers)
                {
                    <div class="relative group rounded-2xl bg-white dark:bg-neutral-900 flex flex-col
                                ring-1 @(tier.Featured
                                    ? "ring-2 ring-accent shadow-lg"
                                    : "ring-slate-200 dark:ring-white/5 hover:ring-accent/40 hover:shadow-lg")
                                transition-all duration-200">
                        @if (tier.Featured)
                        {
                            <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full
                                         bg-accent px-3 py-1 text-xs font-semibold text-white shadow-sm">
                                Most popular
                            </span>
                        }
                        <div class="p-6 flex flex-col flex-1">
                            <h3 class="text-lg font-semibold text-slate-900 dark:text-neutral-100">@tier.Name</h3>
                            <p class="mt-1 text-sm text-slate-500 dark:text-neutral-400">@tier.BestFor</p>
                            <div class="mt-5 flex items-baseline gap-1.5">
                                <span class="text-xs font-medium uppercase tracking-widest text-slate-400 dark:text-neutral-500">From</span>
                                <span class="text-4xl font-semibold tracking-tight text-slate-900 dark:text-white">@tier.Price</span>
                            </div>
                            <p class="mt-1 text-xs text-slate-400 dark:text-neutral-500">@tier.PriceCaption</p>
                            <ul class="mt-6 space-y-2.5 flex-1">
                                @foreach (var feature in tier.Features)
                                {
                                    <li class="flex items-start gap-2 text-sm text-slate-500 dark:text-neutral-400">
                                        <span class="mt-0.5 font-bold text-accent">✓</span>
                                        @feature
                                    </li>
                                }
                            </ul>
                            <a href="/contact"
                               class="mt-6 rounded-xl px-5 py-2.5 text-sm font-semibold text-center transition-all
                                      @(tier.Featured
                                        ? "bg-accent text-white shadow-sm hover:opacity-90"
                                        : "text-slate-700 dark:text-neutral-200 ring-1 ring-slate-200 dark:ring-white/10 hover:bg-slate-50 dark:hover:bg-white/5")">
                                Get a quote
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Care plans -->
            <div class="mt-16">
                <div class="flex items-end justify-between flex-wrap gap-3 mb-6">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-widest text-slate-400 dark:text-neutral-500">Hosting &amp; support</p>
                        <h3 class="mt-1 text-2xl font-semibold text-slate-900 dark:text-neutral-100">Ongoing care plans</h3>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-neutral-400 max-w-sm">
                        Optional monthly plans that keep your site fast, secure, and up to date — we manage everything for you.
                    </p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    @foreach (var plan in _carePlans)
                    {
                        <div class="rounded-2xl bg-slate-50 dark:bg-neutral-900 ring-1 ring-slate-200 dark:ring-white/5 p-6 flex flex-col">
                            <div class="flex items-baseline justify-between gap-2">
                                <h4 class="text-base font-semibold text-slate-900 dark:text-neutral-100">@plan.Name</h4>
                                <span class="text-lg font-semibold text-accent whitespace-nowrap">@plan.Price</span>
                            </div>
                            <ul class="mt-4 space-y-2">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-start gap-2 text-sm text-slate-500 dark:text-neutral-400">
                                        <span class="mt-0.5 font-bold text-accent">✓</span>
                                        @feature
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

            <!-- Flagship bundle -->
            <div class="mt-10 rounded-2xl ring-1 ring-accent/30 bg-accent/5 dark:bg-accent/10 p-8
                        flex flex-col md:flex-row md:items-center gap-6">
                <div class="flex-1">
                    <p class="text-xs font-semibold uppercase tracking-widest text-accent">Flagship bundle</p>
                    <h3 class="mt-2 text-xl font-semibold text-slate-900 dark:text-neutral-100">The Digital Setup Package</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-neutral-400 max-w-xl">
                        Any website package with a starter automation included and hosting as an optional add-on — your
                        website and systems fully set up so your business runs more efficiently and generates more enquiries.
                    </p>
                </div>
                <a href="/contact"
                   class="flex-shrink-0 rounded-xl bg-accent px-6 py-3 text-sm font-semibold
                          text-white shadow-sm hover:opacity-90 transition-all text-center">
                    Build my package
                </a>
            </div>
        </div>
    </section>

    <!-- ── BENTO: CAPABILITIES ────────────────────────────────────────────── -->
    <section class="py-20 px-6 bg-slate-50 dark:bg-neutral-900 transition-colors duration-300">
        <div class="max-w-7xl mx-auto">
            <SectionHeader Label="About us"
                           Heading="Design-led, and built to last."
                           Description="We obsess over the details — from performance and accessibility to typography and hover states." />

            <div class="mt-12 flex flex-col lg:flex-row gap-3 items-stretch">

                <!-- LEFT: Disciplines -->
                <div class="bg-white dark:bg-neutral-900 ring-1 ring-slate-200 dark:ring-white/5
                            rounded-[18px] overflow-hidden flex flex-col
                            w-full lg:w-[300px] lg:flex-shrink-0">
                    <div class="bg-slate-50 dark:bg-neutral-800 flex flex-col items-center justify-center gap-6 p-8" style="min-height:300px;">
                        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:7px;">
                            @foreach (var (on, opacity) in _dotPattern)
                            {
                                <div class="rounded-full @(on ? $"bg-accent opacity-{opacity}" : "bg-slate-200 dark:bg-neutral-600")"
                                     style="width:8px;height:8px;"></div>
                            }
                        </div>
                        <div class="flex flex-col gap-2.5 w-full">
                            @foreach (var (label, width) in _disciplines)
                            {
                                <div class="flex flex-col gap-1">
                                    <span class="text-xs text-slate-400 dark:text-neutral-500">@label</span>
                                    <div class="bg-slate-200 dark:bg-neutral-700 h-1 rounded-full overflow-hidden">
                                        <div class="bg-accent h-full rounded-full"
                                             style="width:@(width)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="p-8">
                        <p class="text-xs font-medium uppercase tracking-widest text-accent">What we do</p>
                        <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-neutral-100">Two practices, one partner</p>
                        <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-neutral-400">Premium websites and intelligent automation, both done properly.</p>
                    </div>
                </div>

                <!-- MIDDLE: Two stacked cards -->
                <div class="flex flex-col gap-3 flex-1 min-w-0">

                    <!-- 100% Bespoke -->
                    <div class="bg-white dark:bg-neutral-900 ring-1 ring-slate-200 dark:ring-white/5 rounded-[18px] overflow-hidden flex flex-col flex-1">
                        <div class="bg-slate-50 dark:bg-neutral-800 flex items-center justify-center" style="min-height:160px;">
                            <div class="text-center px-8 py-6">
                                <p class="text-accent text-6xl font-medium leading-none">
                                    100%
                                </p>
                                <p class="text-sm text-slate-500 dark:text-neutral-400 mt-2">Bespoke. No templates, no guesswork.</p>
                            </div>
                        </div>
                        <div class="px-8 py-6">
                            <p class="text-xs font-medium uppercase tracking-widest text-accent">Our approach</p>
                            <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-neutral-100">Built around your business</p>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="bg-white dark:bg-neutral-900 ring-1 ring-slate-200 dark:ring-white/5 rounded-[18px] overflow-hidden flex flex-col flex-1">
                        <div class="bg-slate-50 dark:bg-neutral-800 flex items-center justify-center" style="min-height:160px;">
                            <div class="flex flex-col items-center gap-4 py-6">
                                <div class="relative w-16 h-16 flex items-center justify-center">
                                    <div class="animate-ping rounded-full ring-1 ring-accent/20 absolute w-16 h-16" style="animation-duration:2.4s;"></div>
                                    <div class="animate-ping rounded-full ring-1 ring-accent/30 absolute w-11 h-11" style="animation-duration:1.8s;animation-delay:0.4s;"></div>
                                    <div class="bg-accent/10 ring-1 ring-accent/40 rounded-full w-7 h-7 flex items-center justify-center">
                                        <span class="rounded-full bg-green-500 w-2 h-2 block"></span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="rounded-full bg-green-500 w-1.5 h-1.5 flex-shrink-0 block"></span>
                                    <span class="text-xs text-slate-500 dark:text-neutral-400">Remote-first. Always reachable.</span>
                                </div>
                            </div>
                        </div>
                        <div class="px-8 py-6">
                            <p class="text-xs font-medium uppercase tracking-widest text-accent">UK-wide</p>
                            <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-neutral-100">Based in Keswick, working everywhere</p>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: Website delivery pipeline -->
                <div class="bg-white dark:bg-neutral-900 ring-1 ring-slate-200 dark:ring-white/5
                            rounded-[18px] overflow-hidden flex flex-col
                            w-full lg:w-[300px] lg:flex-shrink-0">
                    <div class="bg-slate-50 dark:bg-neutral-800 flex items-center justify-center p-8" style="min-height:300px;">
                        <div class="flex flex-col items-start w-full space-y-0">
                            @foreach (var (icon, label, isLast) in _deliveryPipeline)
                            {
                                <div class="flex items-center gap-3">
                                    <div class="bg-white dark:bg-neutral-900 ring-1 ring-slate-200 dark:ring-white/5 w-9 h-9 rounded-[10px] flex-shrink-0 flex items-center justify-center">
                                        @((MarkupString)icon)
                                    </div>
                                    <span class="text-sm text-slate-500 dark:text-neutral-400">@label</span>
                                </div>
                                @if (!isLast)
                                {
                                    <div class="bg-slate-200 dark:bg-neutral-700 w-px h-4 ml-[17px]"></div>
                                }
                            }
                        </div>
                    </div>
                    <div class="p-8">
                        <p class="text-xs font-medium uppercase tracking-widest text-accent">How we deliver</p>
                        <p class="mt-2 text-lg font-semibold text-slate-900 dark:text-neutral-100">Discovery to launch</p>
                        <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-neutral-400">Every stage tracked in your project portal.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── WEBSITE SERVICES ───────────────────────────────────────────────── -->
    <section class="py-20 px-6 bg-white dark:bg-neutral-950 transition-colors duration-300">
        <div class="max-w-7xl mx-auto">
            <SectionHeader Label="Services"
                           Heading="Everything a website project needs."
                           Description="From the initial design concept to long-term hosting and support — all under one roof." />

            <div class="mt-16 flex flex-col divide-y divide-slate-200 dark:divide-white/5">
                @foreach (var (svc, index) in _websiteServices.Select((s, i) => (s, i)))
                {
                    bool reverse = index % 2 != 0;
                    <div class="grid md:grid-cols-2 gap-12 py-16 items-center">

                        <!-- Visual panel -->
                        <div class="@(reverse ? "md:order-last" : "")
                                    rounded-2xl bg-white dark:bg-neutral-900
                                    ring-1 ring-slate-200 dark:ring-white/5
                                    h-52 flex items-center justify-center overflow-hidden px-8">
                            @((MarkupString)svc.Visual)
                        </div>

                        <!-- Content panel -->
                        <div class="flex flex-col gap-4">
                            <p class="text-sm font-medium uppercase tracking-widest text-slate-400 dark:text-neutral-500">
                                @svc.Number
                            </p>
                            <h3 class="text-2xl font-semibold text-slate-900 dark:text-neutral-100">
                                @svc.Title
                            </h3>
                            <p class="text-base leading-relaxed text-slate-500 dark:text-neutral-400">
                                @svc.Description
                            </p>
                            <div class="flex flex-wrap gap-2 mt-1">
                                @foreach (var tag in svc.Tags)
                                {
                                    <span class="rounded-full px-3 py-1 text-xs font-medium
                                                 bg-slate-100 text-slate-600
                                                 dark:bg-neutral-800 dark:text-neutral-300">
                                        @tag
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ── AREAS WE SERVE ─────────────────────────────────────────────────── -->
    <section class="py-20 px-6 bg-slate-50 dark:bg-neutral-900 transition-colors duration-300">
        <div class="max-w-5xl mx-auto">
            <SectionHeader Label="Areas we serve"
                           Heading="Website design across Cumbria."
                           Description="We're based in Keswick and build websites for businesses right across Cumbria and the Lake District. Find your area:" />

            <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
                @foreach (var loc in FellsideDigital.Web.Components.Pages.Marketing.LocationData.All)
                {
                    <a href="/website-design/@loc.Slug"
                       class="group rounded-2xl bg-white dark:bg-neutral-900
                              ring-1 ring-slate-200 dark:ring-white/5
                              hover:ring-accent/40 hover:shadow-lg transition-all p-6 text-center">
                        <p class="text-base font-semibold text-slate-900 dark:text-neutral-100 group-hover:text-accent transition-colors">@loc.Town</p>
                        <p class="mt-1 text-xs text-slate-400 dark:text-neutral-500">Website design</p>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- ── CTA ────────────────────────────────────────────────────────────── -->
    <section class="py-24 px-6 relative overflow-hidden bg-white dark:bg-neutral-950 transition-colors duration-300">
        <div class="hero-glow opacity-20" aria-hidden="true"></div>
        <div class="relative z-10 max-w-2xl mx-auto text-center space-y-6">
            <p class="text-sm font-medium uppercase tracking-widest text-slate-400 dark:text-neutral-500">
                Ready for a new website?
            </p>
            <h2 class="text-4xl md:text-5xl font-semibold tracking-tight text-balance text-slate-900 dark:text-white">
                Let's build something
                <span class="text-accent"> you're proud of.</span>
            </h2>
            <p class="text-base text-slate-500 dark:text-neutral-400">
                Tell us about your project and we'll come back with a clear plan and fixed price.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
                <a href="/contact"
                   class="rounded-xl bg-accent px-7 py-3 text-sm font-semibold
                          text-white shadow-lg hover:opacity-90 transition-all">
                    Get a quote
                </a>
                <a href="/automation"
                   class="text-sm font-medium text-slate-500 dark:text-neutral-400
                          hover:text-accent transition-colors">
                    Also need automation? →
                </a>
            </div>
        </div>
    </section>

</div>

