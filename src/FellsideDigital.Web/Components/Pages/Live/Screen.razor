@page "/live"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "SiteAdmin")]
@layout FellsideDigital.Web.Components.Layout.LiveLayout
@implements IDisposable
@using Microsoft.AspNetCore.Authorization

<PageTitle>Live Automation — Fellside Digital</PageTitle>

<div class="relative min-h-screen flex flex-col">

    <!-- Floating controls (no navbar / logo) -->
    <div class="absolute top-5 right-5 z-30 flex items-center gap-2">
        @if (!_stopped)
        {
            <button @onclick="StopAsync"
                    class="rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-lg hover:opacity-90 transition-opacity">
                ■ Stop &amp; show results
            </button>
        }
        else
        {
            <button @onclick="Resume"
                    class="rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-lg hover:opacity-90 transition-opacity">
                ▶ Back to live
            </button>
        }
        <button @onclick="ResetAsync"
                class="rounded-xl border border-slate-200 dark:border-white/10 px-4 py-2.5 text-sm text-slate-500 dark:text-neutral-400 hover:border-slate-300 dark:hover:border-white/20 transition">
            Reset
        </button>
    </div>

    @if (!_stopped)
    {
        <!-- ===================== LIVE VIEW ===================== -->
        <div class="flex-1 grid grid-cols-1 lg:grid-cols-5 gap-10 px-10 py-14 items-center">

            <!-- QR + count -->
            <div class="lg:col-span-2 flex flex-col items-center text-center">
                <h1 class="text-4xl xl:text-5xl font-black mb-3 leading-tight">Scan to see it live</h1>
                <p class="text-lg text-slate-500 dark:text-neutral-400 mb-8">
                    Point your camera here and watch this screen react in real time.
                </p>
                <div class="p-6 rounded-[2rem] border-4 border-accent shadow-2xl bg-white">
                    <img src="/api/live/qr.svg" alt="Scan to join"
                         class="w-64 h-64 sm:w-80 sm:h-80 xl:w-[26rem] xl:h-[26rem]" />
                </div>
                <div class="mt-8 text-8xl xl:text-9xl font-black text-accent tabular-nums leading-none">@_count</div>
                <div class="mt-2 text-slate-400 uppercase tracking-[0.2em] text-sm">people joined</div>
            </div>

            <!-- Pipeline + feed -->
            <div class="lg:col-span-3 flex flex-col justify-center">
                <div class="rounded-[2rem] border border-slate-200 dark:border-white/10 shadow-xl p-10 min-h-[26rem] flex flex-col justify-center">
                    @if (_current is null)
                    {
                        <div class="text-center text-slate-400">
                            <div class="text-4xl font-semibold">Waiting for the next lead…</div>
                            <div class="mt-3 text-xl">Scan the QR code to trigger a live automation.</div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-10">
                            <div class="text-sm uppercase tracking-[0.2em] text-slate-400">Now processing</div>
                            <div class="text-5xl xl:text-6xl font-black mt-1">@_current.Name</div>
                        </div>
                        <div class="space-y-4">
                            @for (var i = 0; i < _stages.Length; i++)
                            {
                                var done = i < _activeStage || (i == _activeStage && _stageComplete);
                                var active = i == _activeStage;
                                <div class="@StageRowClass(active, done)">
                                    <span class="@StageDotClass(active, done)"></span>
                                    <span class="text-2xl font-medium">@_stages[i]</span>
                                    <span class="ml-auto text-2xl font-bold text-accent @(done ? "opacity-100" : "opacity-0") transition-opacity">✓</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mt-8">
                    <div class="text-sm uppercase tracking-[0.2em] text-slate-400 mb-4">Live feed</div>
                    <ul class="space-y-3">
                        @foreach (var p in _feed)
                        {
                            <li class="flex items-center gap-4 text-xl text-slate-600 dark:text-neutral-300">
                                <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
                                <span class="font-semibold text-slate-900 dark:text-white">@p.Name</span>
                                @if (!string.IsNullOrEmpty(p.Company))
                                {
                                    <span class="text-slate-400">· @p.Company</span>
                                }
                                <span class="text-slate-300 dark:text-neutral-600 text-base ml-auto">just now</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ===================== RESULTS DASHBOARD ===================== -->
        <div class="flex-1 px-10 py-14">
            <div class="text-center mb-10">
                <div class="text-sm uppercase tracking-[0.25em] text-accent font-semibold">Session results</div>
                <h1 class="text-4xl xl:text-5xl font-black mt-2">Here's who just triggered a live automation</h1>
            </div>

            @if (_metrics.Total == 0)
            {
                <div class="text-center text-slate-400 mt-24">
                    <div class="text-3xl font-semibold">No one joined this session yet.</div>
                    <div class="mt-3 text-lg">Hit “Back to live” and get the room scanning.</div>
                </div>
            }
            else
            {
                <!-- Hero total -->
                <div class="text-center mb-14 transition-all duration-700 @(_reveal ? "opacity-100 scale-100" : "opacity-0 scale-90")">
                    <div class="text-[9rem] xl:text-[12rem] font-black text-accent tabular-nums leading-none">@_metrics.Total</div>
                    <div class="text-xl text-slate-400 uppercase tracking-[0.2em] -mt-2">automations triggered, live</div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                    <!-- Device split donut -->
                    <div class="rounded-[2rem] border border-slate-200 dark:border-white/10 shadow-xl p-8">
                        <div class="text-sm uppercase tracking-[0.2em] text-slate-400 mb-6">Device split</div>
                        <div class="flex flex-col items-center">
                            <div class="relative w-56 h-56">
                                <svg viewBox="0 0 200 200" class="w-56 h-56 -rotate-90">
                                    <circle cx="100" cy="100" r="84" fill="none" stroke-width="22"
                                            class="stroke-slate-100 dark:stroke-white/10" />
                                    @foreach (var seg in DonutSegments())
                                    {
                                        <circle cx="100" cy="100" r="84" fill="none" stroke-width="22"
                                                stroke="@seg.Color" stroke-linecap="butt"
                                                stroke-dasharray="@Fmt(_reveal ? seg.Length : 0) @Fmt(DonutCircumference)"
                                                stroke-dashoffset="@Fmt(seg.Offset)"
                                                style="transition: stroke-dasharray 900ms ease" />
                                    }
                                </svg>
                                <div class="absolute inset-0 flex flex-col items-center justify-center">
                                    <div class="text-5xl font-black tabular-nums">@_metrics.Total</div>
                                    <div class="text-xs uppercase tracking-widest text-slate-400">devices</div>
                                </div>
                            </div>
                            <div class="w-full mt-6 space-y-2">
                                @foreach (var seg in DonutSegments())
                                {
                                    <div class="flex items-center gap-3 text-lg">
                                        <span class="w-3.5 h-3.5 rounded-full" style="background:@seg.Color"></span>
                                        <span class="font-medium">@seg.Label</span>
                                        <span class="ml-auto text-slate-400 tabular-nums">@seg.Count · @Percent(seg.Count, _metrics.Total)%</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Sources (companies or providers) -->
                    <div class="rounded-[2rem] border border-slate-200 dark:border-white/10 shadow-xl p-8">
                        <div class="text-sm uppercase tracking-[0.2em] text-slate-400 mb-1">
                            @(_metrics.SourcesAreCompanies ? "Companies in the room" : "Where they signed up")
                        </div>
                        <div class="text-xs text-slate-400 mb-6">
                            @(_metrics.SourcesAreCompanies ? "resolved from email domains" : "by email provider")
                        </div>
                        @if (_metrics.Sources.Count == 0)
                        {
                            <p class="text-slate-400">No source data captured.</p>
                        }
                        else
                        {
                            var maxSrc = _metrics.Sources.Max(s => s.Count);
                            <div class="space-y-4">
                                @foreach (var s in _metrics.Sources)
                                {
                                    var w = maxSrc == 0 ? 0 : (int)Math.Round(100.0 * s.Count / maxSrc);
                                    <div>
                                        <div class="flex justify-between text-lg mb-1.5">
                                            <span class="font-medium truncate pr-2">@s.Label</span>
                                            <span class="text-slate-400 tabular-nums">@s.Count</span>
                                        </div>
                                        <div class="h-3.5 rounded-full bg-slate-100 dark:bg-white/10 overflow-hidden">
                                            <div class="h-full rounded-full bg-accent"
                                                 style="width:@(_reveal ? w : 0)%; transition: width 900ms ease"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Join timeline / peak -->
                    <div class="rounded-[2rem] border border-slate-200 dark:border-white/10 shadow-xl p-8 flex flex-col">
                        <div class="text-sm uppercase tracking-[0.2em] text-slate-400 mb-6">Join timeline</div>
                        <div class="flex-1 flex items-end gap-1.5 min-h-[10rem]">
                            @foreach (var c in _metrics.Timeline)
                            {
                                var h = _metrics.PeakCount == 0 ? 0 : (int)Math.Round(100.0 * c / _metrics.PeakCount);
                                <div class="flex-1 rounded-t-md bg-accent/70"
                                     style="height:@(_reveal ? Math.Max(h, c > 0 ? 6 : 0) : 0)%; transition: height 900ms ease"></div>
                            }
                        </div>
                        <div class="mt-6 text-center">
                            <div class="text-3xl font-black text-accent">@_metrics.PeakWindowLabel</div>
                            <div class="text-sm text-slate-400 mt-1">busiest moment of the session</div>
                        </div>
                    </div>

                </div>
            }
        </div>
    }
</div>
