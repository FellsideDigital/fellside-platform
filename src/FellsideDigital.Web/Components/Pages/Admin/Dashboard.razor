@page "/Admin"
@attribute [Authorize(Roles = "SiteAdmin")]
@layout AdminLayout

@using FellsideDigital.Domain.Enums
@using FellsideDigital.Domain.Extensions
@using Microsoft.AspNetCore.Authorization
@using FellsideDigital.Web.Components.Layout
@using FellsideDigital.Web.Components.Shared

<PageTitle>Overview — Fellside Digital Admin</PageTitle>

<PageHeader Eyebrow="Admin" Title="Overview" Description="Everything that needs your attention, at a glance.">
    <Actions>
        <PrimaryButton Href="/Admin/Projects/Create">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            New project
        </PrimaryButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="animate-pulse space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
            @for (var i = 0; i < 4; i++)
            {
                <div class="rounded-2xl border border-gray-200 dark:border-white/5 bg-white dark:bg-neutral-900 h-24"></div>
            }
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            <div class="rounded-2xl border border-gray-200 dark:border-white/5 bg-white dark:bg-neutral-900 h-72"></div>
            <div class="rounded-2xl border border-gray-200 dark:border-white/5 bg-white dark:bg-neutral-900 h-72"></div>
        </div>
    </div>
}
else
{
    <!-- KPI row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 mb-5">
        <a href="/Admin/Projects" class="block">
            <KpiCard Eyebrow="Active projects"
                     Value="@_activeProjects.ToString()"
                     Sub="@($"{_projects.Count} total")"
                     IconPath="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
                     Tone="blue" />
        </a>
        <a href="/Admin/Invoices" class="block">
            <KpiCard Eyebrow="Outstanding"
                     Value="@($"£{_outstandingTotal:N0}")"
                     Sub="@($"{_overdueCount} overdue · £{_totalEarned:N0} earned")"
                     IconPath="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                     Tone="emerald" />
        </a>
        <a href="/Admin/Enquiries" class="block">
            <KpiCard Eyebrow="Unread enquiries"
                     Value="@_unreadEnquiries.ToString()"
                     Sub="@($"{_enquiries.Count} all-time")"
                     IconPath="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                     Tone="amber" />
        </a>
        <a href="/Admin/Invitations" class="block">
            <KpiCard Eyebrow="Pending invites"
                     Value="@_pendingInvitations.ToString()"
                     Sub="Awaiting acceptance"
                     IconPath="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
                     Tone="rose" />
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

        <!-- Recent projects -->
        <CardSection Class="flex flex-col">
            <Header>
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Recent projects</h2>
                    <a href="/Admin/Projects" class="text-sm font-semibold text-accent hover:opacity-80 transition-opacity">View all →</a>
                </div>
            </Header>
            <ChildContent>
                @if (_recentProjects.Any())
                {
                    <ul role="list" class="divide-y divide-gray-100 dark:divide-white/5">
                        @foreach (var p in _recentProjects)
                        {
                            <li>
                                <a href="@($"/Admin/Projects/{p.Id}")"
                                   class="flex items-center gap-3 px-6 py-4 hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
                                    <span class="size-2 shrink-0 rounded-full @BadgeHelpers.ProjectStatusDotColor(p.Status)"></span>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-sm font-semibold text-gray-900 dark:text-white truncate">@p.Name</p>
                                        <p class="text-xs text-gray-500 dark:text-neutral-400 truncate">@ClientName(p.Client)</p>
                                    </div>
                                    <StatusBadge CssClasses="@BadgeHelpers.ProjectStatusBadge(p.Status)"
                                                 Label="@p.Status.DisplayName()" />
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="px-6 py-10 text-center">
                        <p class="text-sm text-gray-400 dark:text-neutral-500 mb-2">No projects yet.</p>
                        <a href="/Admin/Projects/Create" class="text-sm font-semibold text-accent hover:underline">Create your first project →</a>
                    </div>
                }
            </ChildContent>
        </CardSection>

        <!-- Needs attention -->
        <CardSection Class="flex flex-col">
            <Header>
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Needs attention</h2>
                    <a href="/Admin/Invoices" class="text-sm font-semibold text-accent hover:opacity-80 transition-opacity">Invoices →</a>
                </div>
            </Header>
            <ChildContent>
                @if (_overdueInvoices.Any())
                {
                    <ul role="list" class="divide-y divide-gray-100 dark:divide-white/5">
                        @foreach (var inv in _overdueInvoices)
                        {
                            <li class="flex items-center gap-3 px-6 py-4">
                                <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-rose-50 dark:bg-rose-500/10">
                                    <svg class="size-4 text-rose-500 dark:text-rose-400" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                                    </svg>
                                </span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-semibold text-gray-900 dark:text-white truncate">@inv.Title</p>
                                    <p class="text-xs text-gray-500 dark:text-neutral-400 truncate">
                                        @ClientName(inv.Project?.Client) · due @(inv.DueAt?.ToLocalTime().ToString("d MMM yyyy") ?? "—")
                                    </p>
                                </div>
                                <span class="text-sm font-semibold text-gray-900 dark:text-white">@inv.Currency @inv.Amount.ToString("N0")</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="px-6 py-10 text-center">
                        <div class="inline-flex size-12 items-center justify-center rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 mb-3">
                            <svg class="size-6 text-emerald-500 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                        </div>
                        <p class="text-sm font-semibold text-gray-900 dark:text-white">All caught up</p>
                        <p class="text-xs text-gray-400 dark:text-neutral-500 mt-1">No overdue invoices right now.</p>
                    </div>
                }
            </ChildContent>
        </CardSection>
    </div>
}
