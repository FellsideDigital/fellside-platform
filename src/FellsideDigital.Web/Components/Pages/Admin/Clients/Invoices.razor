@page "/Admin/Clients/{ClientId}/Invoices"
@attribute [Authorize(Roles = "SiteAdmin")]
@layout AdminLayout

@using FellsideDigital.Domain.Enums
@using FellsideDigital.Domain.Extensions
@using Microsoft.AspNetCore.Authorization
@using FellsideDigital.Web.Components.Layout
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Invoices — Fellside Digital Admin</PageTitle>

<a href="@_backHref"
   class="inline-flex items-center gap-1 text-xs font-medium text-gray-500 dark:text-neutral-400 hover:text-gray-900 dark:hover:text-white transition-colors mb-3">
    <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
    Back to project
</a>

<PageHeader Eyebrow="Client" Title="Invoices" Description="@_clientLine" />

@if (_loading)
{
    <div class="animate-pulse space-y-3">
        <div class="rounded-2xl border border-gray-200 dark:border-white/5 bg-white dark:bg-neutral-900 h-24"></div>
        <div class="rounded-2xl border border-gray-200 dark:border-white/5 bg-white dark:bg-neutral-900 h-48"></div>
    </div>
}
else
{
    <!-- Summary -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 mb-5">
        <KpiCard Eyebrow="Total earned"
                 Value="@($"£{_totalEarned:N0}")"
                 Sub="Paid invoices + retainers"
                 IconPath="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                 Tone="emerald" />
        <KpiCard Eyebrow="Invoiced"
                 Value="@($"£{_invoices.Sum(i => i.Amount):N0}")"
                 Sub="@($"{_invoices.Count} invoice{(_invoices.Count == 1 ? "" : "s")}")"
                 IconPath="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"
                 Tone="blue" />
        <KpiCard Eyebrow="Outstanding"
                 Value="@($"£{_outstandingTotal:N0}")"
                 Sub="@_outstandingSub"
                 IconPath="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"
                 Tone="rose" />
        <KpiCard Eyebrow="Paid"
                 Value="@($"£{_paidTotal:N0}")"
                 Sub="@($"{_invoices.Count(i => i.Status == InvoiceStatus.Paid)} settled")"
                 IconPath="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                 Tone="accent" />
    </div>

    <!-- Invoice list -->
    <CardSection Title="All invoices" Class="mb-5">
        @if (_invoices.Count == 0)
        {
            <div class="px-6 py-10 text-center">
                <p class="text-sm text-gray-400 dark:text-neutral-500">No invoices for this client yet.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
            <table class="@TableStyles.Table">
                <thead>
                    <tr class="@TableStyles.HeadRow">
                        <Th>Invoice</Th>
                        <Th Class="hidden md:table-cell">Project</Th>
                        <Th>Amount</Th>
                        <Th>Status</Th>
                        <Th Right>Actions</Th>
                    </tr>
                </thead>
                <tbody class="@TableStyles.Body">
                    @foreach (var inv in _invoices)
                    {
                        <tr class="@TableStyles.Row">
                            <Td>
                                <p class="text-sm font-semibold text-gray-900 dark:text-white">@inv.Title</p>
                                <p class="text-xs text-gray-500 dark:text-neutral-400">@inv.IssuedAt.ToLocalTime().ToString("d MMM yyyy")</p>
                            </Td>
                            <Td Class="hidden md:table-cell">
                                <span class="text-sm text-gray-700 dark:text-neutral-300">@inv.Project?.Name</span>
                            </Td>
                            <Td>
                                <span class="text-sm text-gray-900 dark:text-white">@inv.Currency @inv.Amount.ToString("N2")</span>
                            </Td>
                            <Td>
                                <select value="@inv.Status"
                                        @onchange="e => ChangeStatusAsync(inv.Id, e)"
                                        class="text-xs rounded-lg border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-white/5 text-gray-700 dark:text-neutral-300 px-2 py-1.5 focus:ring-1 focus:ring-accent outline-none">
                                    @foreach (var opt in EnumExtensions.ToOptions<InvoiceStatus>())
                                    {
                                        <option value="@opt.Value">@opt.Display</option>
                                    }
                                </select>
                            </Td>
                            <Td>
                                <div class="flex items-center justify-end gap-3">
                                    @if (_downloadUrls.TryGetValue(inv.Id, out var links))
                                    {
                                        <FileActions ViewUrl="@links.ViewUrl" DownloadUrl="@links.DownloadUrl" />
                                    }
                                    <button @onclick="() => OpenEdit(inv)"
                                            class="text-xs font-medium text-accent hover:underline transition-colors">
                                        Edit
                                    </button>
                                    <button @onclick="() => DeleteInvoiceAsync(inv.Id)"
                                            class="text-xs font-medium text-red-500 dark:text-red-400 hover:text-red-600 dark:hover:text-red-300 transition-colors">
                                        Delete
                                    </button>
                                </div>
                            </Td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </CardSection>

    <!-- Recurring invoices -->
    <CardSection Title="Recurring invoices" Class="mb-5">
        @if (_schedules.Count > 0)
        {
            <div class="overflow-x-auto">
            <table class="@TableStyles.Table">
                <thead>
                    <tr class="@TableStyles.HeadRow">
                        <Th>Schedule</Th>
                        <Th Class="hidden md:table-cell">Project</Th>
                        <Th>Amount</Th>
                        <Th Class="hidden lg:table-cell">Collected to date</Th>
                        <Th Class="hidden sm:table-cell">Next issue</Th>
                        <Th>Status</Th>
                        <Th Right>Actions</Th>
                    </tr>
                </thead>
                <tbody class="@TableStyles.Body">
                    @foreach (var s in _schedules)
                    {
                        <tr class="@TableStyles.Row">
                            <Td>
                                <p class="text-sm font-semibold text-gray-900 dark:text-white">@s.Title</p>
                                <p class="text-xs text-gray-500 dark:text-neutral-400">Collected on the @s.PaymentDayOfMonth.ToOrdinal() of each month</p>
                            </Td>
                            <Td Class="hidden md:table-cell">
                                <span class="text-sm text-gray-700 dark:text-neutral-300">@s.Project?.Name</span>
                            </Td>
                            <Td>
                                <span class="text-sm text-gray-900 dark:text-white">@s.Currency @s.Amount.ToString("N2")<span class="text-xs text-gray-500 dark:text-neutral-400">/mo</span></span>
                            </Td>
                            <Td Class="hidden lg:table-cell">
                                <span class="text-sm font-semibold text-gray-900 dark:text-white">@s.Currency @RecurringService.CollectedToDate(s, DateTime.UtcNow).ToString("N2")</span>
                                <span class="block text-[11px] text-gray-400 dark:text-neutral-500">since @s.FirstPaymentDate.ToString("MMM yyyy")</span>
                            </Td>
                            <Td Class="hidden sm:table-cell">
                                <span class="text-sm text-gray-700 dark:text-neutral-300">@(s.IsActive ? s.NextIssueDate.ToString("d MMM yyyy") : "—")</span>
                            </Td>
                            <Td>
                                <StatusBadge CssClasses="@(s.IsActive ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400" : "bg-gray-100 text-gray-600 dark:bg-white/5 dark:text-neutral-400")"
                                             Dot="@(s.IsActive ? "bg-emerald-400" : "bg-gray-400")"
                                             Label="@(s.IsActive ? "Active" : "Paused")" />
                            </Td>
                            <Td>
                                <div class="flex items-center justify-end gap-3">
                                    <button @onclick="() => OpenScheduleEdit(s)"
                                            class="text-xs font-medium text-accent hover:underline transition-colors">
                                        Edit
                                    </button>
                                    <button @onclick="() => ToggleScheduleAsync(s)"
                                            class="text-xs font-medium text-gray-600 dark:text-neutral-300 hover:underline transition-colors">
                                        @(s.IsActive ? "Pause" : "Resume")
                                    </button>
                                    <button @onclick="() => DeleteScheduleAsync(s.Id)"
                                            class="text-xs font-medium text-red-500 dark:text-red-400 hover:text-red-600 dark:hover:text-red-300 transition-colors">
                                        Delete
                                    </button>
                                </div>
                            </Td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        <div class="px-6 py-5 @(_schedules.Count > 0 ? "border-t border-gray-100 dark:border-white/5" : "")">
            <AlertBanner Message="@_recError" Variant="error" Class="mb-3" />
            @if (_projects.Count == 0)
            {
                <p class="text-sm text-gray-400 dark:text-neutral-500">This client has no projects to attach a recurring invoice to.</p>
            }
            else
            {
                <p class="text-xs text-gray-500 dark:text-neutral-400 mb-3">
                    An invoice is issued automatically on the chosen payment day of each month, with
                    payment due that day. The default is the @_paymentDay.ToOrdinal(), but you can bill
                    this customer on a different day. The client is emailed the invoice, and anything
                    left unpaid gets friendly reminders.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Project *</label>
                        <select @bind="_recProjectId" class="@InputClass">
                            <option value="">— Select project —</option>
                            @foreach (var p in _projects)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Title *</label>
                        <input @bind="_recTitle" placeholder="e.g. Monthly retainer" class="@InputClass" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Amount *</label>
                        <input @bind="_recAmount" type="number" step="0.01" min="0" placeholder="0.00" class="@InputClass" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Currency</label>
                        <select @bind="_recCurrency" class="@InputClass">
                            <option value="GBP">GBP £</option>
                            <option value="USD">USD $</option>
                            <option value="EUR">EUR €</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Payment day *</label>
                        <input @bind="_recPaymentDay" type="number" min="1" max="31" class="@InputClass" />
                        <p class="mt-1 text-[11px] text-gray-400 dark:text-neutral-500">Day of month (1–31)</p>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">First payment *</label>
                        <input @bind="_recFirstPaymentDate" type="date" class="@InputClass" />
                        <p class="mt-1 text-[11px] text-gray-400 dark:text-neutral-500">Back-date for existing retainers</p>
                    </div>
                    <div class="sm:col-span-4 flex justify-end">
                        <SpinnerButton IsLoading="@_recSaving"
                                       LoadingText="Saving…"
                                       Disabled="@(string.IsNullOrWhiteSpace(_recProjectId) || string.IsNullOrWhiteSpace(_recTitle))"
                                       OnClick="AddScheduleAsync">
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                            </svg>
                            <span>Add recurring invoice</span>
                        </SpinnerButton>
                    </div>
                </div>
            }
        </div>
    </CardSection>

    <!-- Add invoice -->
    <CardSection Title="Add invoice">
        <div class="px-6 py-5">
            <AlertBanner Message="@_error" Variant="error" Class="mb-3" />
            @if (_projects.Count == 0)
            {
                <p class="text-sm text-gray-400 dark:text-neutral-500">This client has no projects to attach an invoice to.</p>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Project *</label>
                        <select @bind="_selectedProjectId" class="@InputClass">
                            <option value="">— Select project —</option>
                            @foreach (var p in _projects)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Title *</label>
                        <input @bind="_title" placeholder="e.g. Deposit invoice" class="@InputClass" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Amount *</label>
                        <input @bind="_amount" type="number" step="0.01" min="0" placeholder="0.00" class="@InputClass" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Currency</label>
                        <select @bind="_currency" class="@InputClass">
                            <option value="GBP">GBP £</option>
                            <option value="USD">USD $</option>
                            <option value="EUR">EUR €</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Due date (optional)</label>
                        <input @bind="_dueDate" type="date" class="@InputClass" />
                    </div>
                    <div class="sm:col-span-2">
                        <div class="rounded-xl border-2 border-dashed border-gray-200 dark:border-white/10 p-4 text-center hover:border-accent transition-colors">
                            <InputFile OnChange="OnFileSelected" accept=".pdf,.png,.jpg,.jpeg"
                                       class="block w-full text-xs text-gray-500 dark:text-neutral-400
                                              file:mr-3 file:rounded-lg file:border-0 file:bg-accent
                                              file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white
                                              hover:file:opacity-90 cursor-pointer" />
                            <p class="mt-2 text-xs text-gray-400 dark:text-neutral-500">PDF, PNG or JPG — max 10 MB</p>
                        </div>
                    </div>
                    <div class="sm:col-span-2 flex justify-end">
                        <SpinnerButton IsLoading="@_uploading"
                                       LoadingText="Uploading…"
                                       Disabled="@(_selectedFile is null || string.IsNullOrWhiteSpace(_selectedProjectId) || string.IsNullOrWhiteSpace(_title))"
                                       OnClick="AddInvoiceAsync">
                            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                            </svg>
                            <span>Add invoice</span>
                        </SpinnerButton>
                    </div>
                </div>
            }
        </div>
    </CardSection>
}

<Modal IsOpen="@(_editing is not null)" MaxWidth="max-w-lg" OnBackdropClick="CloseEdit">
    @if (_editing is not null)
    {
        <div class="flex items-start justify-between mb-4">
            <div>
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">Edit invoice</h3>
                <p class="text-xs text-gray-500 dark:text-neutral-400">@_editing.Project?.Name</p>
            </div>
            <button @onclick="CloseEdit" class="text-gray-400 hover:text-gray-600 dark:hover:text-neutral-200 transition-colors">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <AlertBanner Message="@_editError" Variant="error" Class="mb-3" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Title *</label>
                <input @bind="_editTitle" placeholder="e.g. Deposit invoice" class="@InputClass" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Amount *</label>
                <input @bind="_editAmount" type="number" step="0.01" min="0" placeholder="0.00" class="@InputClass" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Currency</label>
                <select @bind="_editCurrency" class="@InputClass">
                    <option value="GBP">GBP £</option>
                    <option value="USD">USD $</option>
                    <option value="EUR">EUR €</option>
                </select>
            </div>
            <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Due date (optional)</label>
                <input @bind="_editDueDate" type="date" class="@InputClass" />
            </div>
            <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Replace document</label>
                <div class="rounded-xl border-2 border-dashed border-gray-200 dark:border-white/10 p-4 text-center hover:border-accent transition-colors">
                    <InputFile OnChange="OnEditFileSelected" accept=".pdf,.png,.jpg,.jpeg"
                               class="block w-full text-xs text-gray-500 dark:text-neutral-400
                                      file:mr-3 file:rounded-lg file:border-0 file:bg-accent
                                      file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white
                                      hover:file:opacity-90 cursor-pointer" />
                    <p class="mt-2 text-xs text-gray-400 dark:text-neutral-500">
                        Leave empty to keep current@(string.IsNullOrEmpty(_editing.FileName) ? "" : $" ({_editing.FileName})") — PDF, PNG or JPG, max 10 MB
                    </p>
                </div>
            </div>
            <div class="sm:col-span-2">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" @bind="_notifyClient"
                           class="rounded border-gray-300 dark:border-white/20 text-accent focus:ring-accent" />
                    <span class="text-xs text-gray-600 dark:text-neutral-300">Notify client by email</span>
                </label>
            </div>
        </div>

        <div class="mt-5 flex justify-end gap-2">
            <button @onclick="CloseEdit"
                    class="px-4 py-2 text-xs font-medium text-gray-600 dark:text-neutral-300 hover:text-gray-900 dark:hover:text-white transition-colors">
                Cancel
            </button>
            <SpinnerButton IsLoading="@_saving"
                           LoadingText="Saving…"
                           Disabled="@string.IsNullOrWhiteSpace(_editTitle)"
                           OnClick="SaveEditAsync">
                <span>Save changes</span>
            </SpinnerButton>
        </div>
    }
</Modal>

<Modal IsOpen="@(_editingSchedule is not null)" MaxWidth="max-w-lg" OnBackdropClick="CloseScheduleEdit">
    @if (_editingSchedule is not null)
    {
        <div class="flex items-start justify-between mb-4">
            <div>
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">Edit recurring invoice</h3>
                <p class="text-xs text-gray-500 dark:text-neutral-400">@_editingSchedule.Project?.Name</p>
            </div>
            <button @onclick="CloseScheduleEdit" class="text-gray-400 hover:text-gray-600 dark:hover:text-neutral-200 transition-colors">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <AlertBanner Message="@_editScheduleError" Variant="error" Class="mb-3" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Title *</label>
                <input @bind="_editScheduleTitle" placeholder="e.g. Monthly retainer" class="@InputClass" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Amount *</label>
                <input @bind="_editScheduleAmount" type="number" step="0.01" min="0" placeholder="0.00" class="@InputClass" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Currency</label>
                <select @bind="_editScheduleCurrency" class="@InputClass">
                    <option value="GBP">GBP £</option>
                    <option value="USD">USD $</option>
                    <option value="EUR">EUR €</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">Payment day *</label>
                <input @bind="_editSchedulePaymentDay" type="number" min="1" max="31" class="@InputClass" />
                <p class="mt-1 text-[11px] text-gray-400 dark:text-neutral-500">Day of month (1–31)</p>
            </div>
            <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-gray-500 dark:text-neutral-400 mb-1.5">First payment date *</label>
                <input @bind="_editScheduleFirstPaymentDate" type="date" class="@InputClass" />
                <p class="mt-1 text-[11px] text-gray-400 dark:text-neutral-500">Anchors the collected-to-date total. Back-date for retainers that began before the platform.</p>
            </div>
        </div>

        <p class="mt-3 text-xs text-gray-400 dark:text-neutral-500">
            Collected on the chosen day each month. Changing the amount or payment day applies from
            the next invoice — invoices already issued are not affected.
        </p>

        <div class="mt-5 flex justify-end gap-2">
            <button @onclick="CloseScheduleEdit"
                    class="px-4 py-2 text-xs font-medium text-gray-600 dark:text-neutral-300 hover:text-gray-900 dark:hover:text-white transition-colors">
                Cancel
            </button>
            <SpinnerButton IsLoading="@_savingSchedule"
                           LoadingText="Saving…"
                           Disabled="@string.IsNullOrWhiteSpace(_editScheduleTitle)"
                           OnClick="SaveScheduleEditAsync">
                <span>Save changes</span>
            </SpinnerButton>
        </div>
    }
</Modal>
