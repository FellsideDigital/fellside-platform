<div class="space-y-6">
    <div>
        <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">
            Recovery codes
        </h2>
    </div>

    <StatusMessage Message="@StatusMessage" />

    <div class="rounded-md bg-yellow-50 p-4 dark:bg-yellow-900/20" role="alert">
        <div class="flex items-start gap-3">
            <svg class="h-5 w-5 flex-shrink-0 text-yellow-700 dark:text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
            </svg>
            <div class="text-sm text-yellow-700 dark:text-yellow-400">
                <p><strong class="font-semibold">Put these codes in a safe place.</strong></p>
                <p class="mt-1">
                    If you lose your device and don't have the recovery codes you will lose access to your account.
                </p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <code class="rounded bg-gray-100 dark:bg-white/10 px-2 py-1 text-center font-mono text-sm text-slate-900 dark:text-white">@recoveryCode</code>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
